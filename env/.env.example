# The release settings `yarn deploy` reads by name (deploykit CONTRACT.md,
# Settings), for an app's git-ignored base env file (env/.env, or what its
# deploy.sh names in settings_files), beside the rest of the machine's
# settings. `yarn deploy settings` lists them and shows what's missing.
# Paths may be relative to the repo's root or start with ~.

# ── Apple (TestFlight, App Store Connect) ───────────────────────────────
# An App Store Connect API key (Users and Access → Integrations, App Manager).
APP_STORE_CONNECT_API_KEY_ID=
APP_STORE_CONNECT_API_KEY_ISSUER_ID=
# Empty: ~/.appstoreconnect/private_keys/AuthKey_<ID>.p8
APP_STORE_CONNECT_API_KEY_PATH=
# The team that signs (developer.apple.com → Membership).
APPLE_TEAM_ID=

# ── Google Play ─────────────────────────────────────────────────────────
# A service account's JSON key with release access in Play Console.
PLAY_JSON_KEY_PATH=
# The upload key Gradle signs with; keep it and its passwords backed up.
#   keytool -genkeypair -v -storetype PKCS12 -keystore <path> -alias upload -keyalg RSA -keysize 2048 -validity 10000
ANDROID_UPLOAD_KEYSTORE_PATH=
ANDROID_UPLOAD_KEYSTORE_PASSWORD=
ANDROID_UPLOAD_KEY_ALIAS=upload
ANDROID_UPLOAD_KEY_PASSWORD=

# ── The deploy UI ───────────────────────────────────────────────────────
# Runs' log folders kept in ~/.cache/<slug>/deploy-logs/ (default 5).
DEPLOY_KEEP_LOGS=5

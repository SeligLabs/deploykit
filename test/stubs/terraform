#!/usr/bin/env bash
# Stub: init, state, plan (-out, -detailed-exitcode 2), show -json, apply, output.
[[ "$1" == -chdir=* ]] && shift
echo "terraform $* (TF_VAR_push_key=${TF_VAR_push_key:-})" >>"$STUB_LOG"
case "$1" in
  init|import|force-unlock) exit 0 ;;
  state) echo aws_lambda_function.a ;;
  plan) for a in "$@"; do [[ $a == -out=* ]] && echo plan >"${a#-out=}"; done
        echo 'aws_lambda_function.a: Refreshing state...'; exit "${STUB_PLAN_STATUS:-2}" ;;
  show) echo '{"resource_changes":[{"mode":"managed","address":"aws_lambda_function.a","type":"aws_lambda_function","change":{"actions":["update"]}}]}' ;;
  apply) echo 'aws_lambda_function.a: Modifications complete after 1s'
         touch "$(dirname "$STUB_LOG")/tf-applied" ;;
  # The state's outputs: none until an apply (STUB_OUTPUTS=1: some already).
  output)
    if [[ -f "$(dirname "$STUB_LOG")/tf-applied" || -n "${STUB_OUTPUTS:-}" ]]; then
      echo '{"api_url":{"value":"https://api.example.invalid"},"table_names":{"value":{"users":"users-t","item-tags":"tags-t"}}}'
    else
      echo '{}'
    fi ;;
esac
exit 0
